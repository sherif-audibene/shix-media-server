[Unit]
Description=shix-media-server (Next.js)
After=network.target

[Service]
Type=simple
# Change to a dedicated user if you prefer; this user must be able to READ
# the VIDEO_FOLDERS paths and WRITE the deploy dir.
User=jenkins
Group=jenkins
WorkingDirectory=/opt/shix-media-server

# next start sets NODE_ENV=production itself; PORT + FFMPEG_PATH are explicit.
# All secrets (AUTH_*, VIDEO_FOLDERS, NEXT_PUBLIC_APP_URL) live in
# /opt/shix-media-server/.env.local, which Next loads at startup.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=FFMPEG_PATH=/usr/bin/ffmpeg

ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000

Restart=on-failure
RestartSec=5

# Basic hardening. PrivateTmp gives the ffmpeg thumbnail cache its own /tmp.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
