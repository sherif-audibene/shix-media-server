# Copy to /opt/shix-media-server/.env.local on the server and fill in.
# This file is loaded by `next start`. Keep it OFF git (it is gitignored).

# Public URL the app is served from (used by the tRPC client).
# For HTTP-only serving use http://HOST:PORT (e.g. http://1.2.3.4:3000).
NEXT_PUBLIC_APP_URL=http://your-host:3000

# Set to "true" when serving over plain HTTP so the session cookie is not
# marked Secure (otherwise the browser drops it and login fails). Leave unset
# / "false" when behind HTTPS.
AUTH_INSECURE_COOKIE=true

# Long random string used to sign the session cookie.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# Login credentials.
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME_strong_password

# Video source folders ON THE SERVER. `Label|/abs/path` entries, `;`-separated.
# The service user must be able to READ these paths.
VIDEO_FOLDERS=Movies|/srv/media/movies;Shows|/srv/media/shows

# System ffmpeg (also set in the systemd unit; either is enough).
FFMPEG_PATH=/usr/bin/ffmpeg
