# App environment. Copy to `.env.local` and adjust.
NODE_ENV=development

# Public base URL used by the tRPC client to reach the API.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign the session cookie. Set a long random value in prod.
AUTH_SECRET=dev-insecure-secret-change-me

# Login credentials (simple single-user auth). Defaults to admin/admin.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Video source folders the app browses. Server-only.
# Format: `Label|/absolute/path` entries separated by `;`.
# If the label is omitted, the folder's basename is used.
VIDEO_FOLDERS=Movies|/Users/sherifhamad/Downloads/mp4;Downloads|/Users/sherifhamad/Downloads
